# Copy to .env (gitignored) and fill in. Never commit real phone numbers or secrets.

# Outreach mode: mock | stable | photon2.
#   mock    = log only, no creds needed (default; anything unrecognised is mock)
#   stable  = Photon Spectrum via the Node sidecar ("photon" is accepted as an alias)
#   photon2 = Photon 2.0 REST API (falls back once to stable if SPECTRUM_* creds exist)
PHOTON_MODE=mock

# Photon 2.0 (PHOTON_MODE=photon2). Bearer API key; keep out of git.
PHOTON2_API_KEY=
PHOTON2_PROJECT_ID=
# User id (pho_usr_...) of the shared-line agent. Run: cd backend && uv run python -m scripts.photon2_enroll --write-env
PHOTON2_AGENT_USER_ID=
# Shared line number assigned to the project (shown by the enroll script). Info only.
PHOTON2_SMS_NUMBER=

# Photon Spectrum project ID (Basic auth username). Empty until the Photon project exists.
SPECTRUM_PROJECT_ID=
# Photon Spectrum project secret (Basic auth password). Keep out of git.
SPECTRUM_PROJECT_SECRET=
# iMessage line used as sender and SIP caller ID.
SPECTRUM_LINE=

# ElevenLabs API key for Conversational AI (outbound voice calls).
ELEVENLABS_API_KEY=
# ID of the ElevenLabs conversational agent that runs the call script.
ELEVENLABS_AGENT_ID=
# ID of the phone number imported into ElevenLabs for SIP outbound calls.
ELEVENLABS_PHONE_NUMBER_ID=

# Teammate demo phones in E.164 format (e.g. +15555550100). Only these can be contacted. Everything else is mock-only.
DEMO_PHONE_A=
DEMO_PHONE_B=
DEMO_PHONE_C=

# Simulation profile. demo compresses escalation timers (escalation_s.demo in backend/config/weights.yaml). normal uses real timers.
SIM_PROFILE=demo
SIDECAR_KEY=                # random string shared by backend + photon-sidecar (guards /api/photon/inbound)

# Database. ./dev.sh sets HITIDE_DB_BACKEND=spacetime (primary, see the SpacetimeDB block below); if SpacetimeDB
# isn't running the backend logs it and falls back to SQLite. Override only to force a backend:
# HITIDE_DB_BACKEND=sqlite            # spacetime | sqlite | mongodb
# HITIDE_DB_PATH=data/floodwatch.sqlite3
# Optional MongoDB (HITIDE_DB_BACKEND=mongodb; local replica set via scripts/start-mongodb.ps1):
# MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=floodwatch
# MONGODB_DATABASE=floodwatch
# 0 disables automatic feed fetching for offline demos/tests; otherwise minimum 30 seconds.
EVIDENCE_POLL_SECONDS=120

# Drone vision (backend/vision). Optional shared secret for POST /api/snapshots from non-browser callers;
# when set, the CLI (vision.run_pipeline --post) sends it as X-Vision-Token.
VISION_INGEST_TOKEN=
# DRONE_MODE=tello flies the real Tello; its hover frames run through the vision model. TELLO_VISION=0 uses
# the old blue-sheet HSV cover only.
TELLO_VISION=1
# Full conditions access is required for flooding. WZDx-only keys cover construction.
DRIVETEXAS_API_KEY=

# --- SpacetimeDB (primary database; see docs/SPACETIMEDB.md) ---
SPACETIME_URL=http://127.0.0.1:3000
SPACETIME_DB=floodwatch
SPACETIME_SERVER=local                 # or maincloud (after `spacetime login`)
SPACETIME_TOKEN=                       # optional: defaults to your spacetime CLI login (`spacetime login show --token`)
# --- Safety pipeline ---
OUTREACH_ALLOW_ENROLLED=0              # 1 = also allow sends to API-enrolled users' phones
SAFETY_API_KEY=                        # if set, safety write routes require header X-Safety-Key
SAFETY_DEMO=0                          # 1 = compress outreach ladder timings for demos
# SAFETY_REGISTRY_PATH=data/user_registry.json
# SAFETY_STATE_PATH=data/safety_state.json
