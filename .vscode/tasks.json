{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flood Watch: MongoDB",
      "type": "shell",
      "command": "powershell -NoProfile -File scripts/start-mongodb.ps1",
      "problemMatcher": []
    },
    {
      "label": "Flood Watch: backend",
      "dependsOn": ["Flood Watch: MongoDB"],
      "type": "shell",
      "command": "python -m uv run uvicorn app.main:app --host 127.0.0.1 --port 8000",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated" }
    },
    {
      "label": "Flood Watch: frontend",
      "type": "shell",
      "command": "npm.cmd run dev -- --host 127.0.0.1",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated" }
    },
    {
      "label": "Flood Watch: start all",
      "dependsOn": ["Flood Watch: backend", "Flood Watch: frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "ECC: audit harness",
      "type": "shell",
      "command": "npm.cmd run audit --prefix .claude",
      "problemMatcher": []
    },
    {
      "label": "ECC: parallel reviews",
      "type": "shell",
      "command": "powershell -NoProfile -File scripts/review-harness.ps1",
      "problemMatcher": [],
      "presentation": { "panel": "dedicated" }
    }
  ]
}
