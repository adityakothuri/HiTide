# Copy to frontend/.env (gitignored). ./dev.sh sets these for you; this is for running `npm run dev` by hand.
# Where the Vite dev server proxies /api, /static and /ws.
VITE_BACKEND_URL=http://localhost:8000
# test | real. Leave unset to follow the backend (/api/health). `?data=test|real` in the URL overrides.
# VITE_DATA_MODE=test
# replay | live. Overrides the weather layer only.
# VITE_WX_MODE=
