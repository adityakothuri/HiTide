# Copy to .env.local (gitignored) to run the app against the HiTide backend.
# Leave EXPO_PUBLIC_API_URL unset to use local sample data.
# EXPO_PUBLIC_* values are bundled into the app: never put secrets here.

# Simulator or web preview on this Mac: http://localhost:8000
# Phone with Expo Go: this Mac's LAN IP, and start the backend with --host 0.0.0.0
EXPO_PUBLIC_API_URL=http://localhost:8000

# The demo persona in data/region_users.json (Dana Whitfield).
EXPO_PUBLIC_USER_ID=hc-dana
